# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ==============================================================================
# VAULT DISTRIBUTED OBJECT STORAGE CONFIGURATION
# ==============================================================================

# Mode 1: Local Development (Embedded SQLite metadata + 4 Local Filesystem Nodes)
DATABASE_MODE="sqlite"
STORAGE_MODE="local"

# Mode 2: Cloud / Supabase / Vercel Deployment
# Uncomment and configure the following when deploying to Cloud/Vercel:
# DATABASE_MODE="supabase"
# STORAGE_MODE="supabase"
# SUPABASE_URL="https://your-project-id.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-server-side-service-role-secret-key"
# SUPABASE_ANON_KEY="your-supabase-anon-key"
